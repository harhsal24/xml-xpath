{
  "name": "xml-xpath-extension",
  "displayName": "XML XPath Extension",
  "publisher": "HB24",
  "version": "3.5.11",
  "engines": {
    "vscode": "^1.50.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:xml",
    "onCommand:xmlXpath.copyXPath",
    "onCommand:xmlXpath.copyUniversalXPath",
    "onCommand:xmlXpath.setParent",
    "onCommand:xmlXpath.clearParent",
    "onCommand:xmlXpath.setMode",
    "onCommand:xmlXpath.setPreferredAttributes",
    "onCommand:xmlXpath.setIgnoreIndexTags",
    "onCommand:xmlXpath.toggleDisableLeafIndex",
    "onCommand:xmlXpath.toggleSkipSingleIndex",
    "onCommand:xmlXpath.toggleParentScopedIndexing",
    "onCommand:xmlXpath.toggleIgnoreParentSegment",
    "onCommand:xmlXpath.searchWithXPath",
    "onCommand:xmlXpath.toggleUseRelativePath",
    "onCommand:xmlXpath.toggleIncludeNamespaces",
    "onCommand:xmlXpath.toggleIncludeDefaultNamespaces",
    "onCommand:xmlXpath.setForceIndexOneFor",
    "onCommand:xmlXpath.setExceptionsToIndexOneForcing",
    "onCommand:xmlXpath.toggleAttributeBasedIndexing",
    "onCommand:xmlXpath.setAttributeBasedIndexingAttribute",
    "onCommand:xmlXpath.recalculateXPath"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "xmlXpath.copyXPath",
        "title": "XML XPath: Copy XPath from Cursor",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.copyUniversalXPath",
        "title": "XML XPath: Copy Universal XPath from Cursor",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.setParent",
        "title": "XML XPath: Set Parent Tag",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.clearParent",
        "title": "XML XPath: Clear Parent Tag",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.setMode",
        "title": "XML XPath: Set XPath Mode",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.setPreferredAttributes",
        "title": "XML XPath: Set Preferred Attributes",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.setIgnoreIndexTags",
        "title": "XML XPath: Set Ignore-Index Tags",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.toggleDisableLeafIndex",
        "title": "XML XPath: Toggle Disable Leaf Index",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.toggleSkipSingleIndex",
        "title": "XML XPath: Toggle Skip Single Index",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.toggleParentScopedIndexing",
        "title": "XML XPath: Toggle Parent-Scoped Indexing",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.toggleIgnoreParentSegment",
        "title": "XML XPath: Toggle Ignore Parent Segment",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.searchWithXPath",
        "title": "XML XPath: Search with XPath",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.setForceIndexOneFor",
        "title": "XML XPath: Set Force Index [1] Tags",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.setExceptionsToIndexOneForcing",
        "title": "XML XPath: Set Exceptions to Force Index [1]",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.toggleAttributeBasedIndexing",
        "title": "XML XPath: Toggle Attribute-Based Indexing",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.setAttributeBasedIndexingAttribute",
        "title": "XML XPath: Set Attribute for Attribute-Based Indexing",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.toggleUseRelativePath",
        "title": "XML XPath: Toggle Use Relative Path",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.toggleIncludeNamespaces",
        "title": "XML XPath: Toggle Include Namespaces",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.toggleIncludeDefaultNamespaces",
        "title": "XML XPath: Toggle Include Default Namespaces",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.recalculateXPath",
        "title": "XML XPath: Recalculate XPath from Cursor",
        "category": "XML XPath"
      }
    ],
    "keybindings": [
      {
        "key": "ctrl+shift+c",
        "command": "xmlXpath.copyXPath",
        "when": "editorTextFocus && editorLangId == xml"
      },
      {
        "key": "ctrl+shift+f",
        "command": "xmlXpath.searchWithXPath",
        "when": "editorTextFocus && editorLangId == xml"
      },

      {
        "key": "alt+shift+x",
        "command": "xmlXpath.searchWithXPath",
        "when": "editorLangId == xml"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "xmlXpath.copyXPath",
          "when": "editorLangId == xml",
          "group": "xmlXpath"
        },
        {
          "command": "xmlXpath.toggleDisableLeafIndex",
          "when": "editorTextFocus",
          "group": "xmlXpath"
        },
        {
          "command": "xmlXpath.toggleSkipSingleIndex",
          "when": "editorTextFocus",
          "group": "xmlXpath"
        }
      ]
    },
    "configuration": {
      "title": "XML XPath Extension",
      "properties": {
        "xmlXpath.parentTag": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Parent tag from which to generate relative XPath."
        },
        "xmlXpath.mode": {
          "type": "object",
          "default": {
            "includeIndices": true,
            "includeAttributes": true
          },
          "description": "XPath generation mode options."
        },
        "xmlXpath.preferredAttributes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Preferred attributes for XPath predicates."
        },
        "xmlXpath.ignoreIndexTags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Tags for which index [1] should be omitted in XPath."
        },
        "xmlXpath.disableLeafIndex": {
          "type": "boolean",
          "default": false,
          "description": "If true, omit the [n] index on the final (leaf) segment of the XPath."
        },
        "xmlXpath.skipSingleIndex": {
          "type": "boolean",
          "default": false,
          "description": "If true, omit all [1] indexes (i.e. when an element is the only child of its tag at that level)."
        },
        "xmlXpath.useParentScopedIndices": {
          "type": "boolean",
          "default": true,
          "description": "If true, reset child-counters per parent; otherwise use global-depth counters."
        },
        "xmlXpath.ignoreParentSegment": {
          "type": "boolean",
          "default": false,
          "description": "When true, omit the parentTag itself from the generated XPath, showing only the descendant path."
        },
        "xmlXpath.maxParseSize": {
          "type": "number",
          "default": 1000000,
          "minimum": 10000,
          "description": "Maximum file size (in bytes) for full document parsing. Files larger than this will use partial parsing for performance. Default: 1MB."
        },
        "xmlXpath.forceIndexOneFor": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Tags that should always show index [1] (when skipSingleIndex is false). Empty array means no forcing."
        },
        "xmlXpath.exceptionsToIndexOneForcing": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Tags that are exceptions to forceIndexOneFor - these will never show [1]."
        },
        "xmlXpath.useAttributeBasedIndexing": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, elements are indexed based on their attribute values. Elements with same tag but different attributes get separate index sequences."
        },
        "xmlXpath.attributeBasedIndexingAttribute": {
          "type": [
            "string",
            "array"
          ],
          "items": {
            "type": "string"
          },
          "default": "",
          "description": "The attribute or array of attributes to use for attribute-based indexing. If empty, uses preferred attributes."
        },
        "xmlXpath.useRelativePath": {
          "type": "boolean",
          "default": false,
          "description": "Generate relative XPath (using //) instead of absolute path"
        },
        "xmlXpath.includeNamespaces": {
          "type": "boolean",
          "default": false,
          "description": "Include namespace prefixes in XPath"
        },
        "xmlXpath.includeDefaultNamespaces": {
          "type": "boolean",
          "default": false,
          "description": "Include default namespace handling in XPath"
        },
        "xmlXpath.defaultNamespacePrefix": {
          "type": "string",
          "default": "d",
          "description": "Namespace prefix to use for elements in default namespaces (when includeDefaultNamespaces is enabled)."
        }
      }
    }
  },
  "scripts": {
    "test": "node test/run-integration-tests.js",
    "test-e2e": "node test/playwright-test.js"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "vscode": "^1.1.37",
    "vscode-test": "^1.4.0"
  }
}
