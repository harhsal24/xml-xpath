{
  "name": "xml-xpath-extension",
  "displayName": "XML XPath Extension",
  "publisher": "HB24",
  "version": "3.5.2",
  "engines": {
    "vscode": "^1.50.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:xml",
    "onCommand:xmlXpath.copyXPath",
    "onCommand:xmlXpath.setParent",
    "onCommand:xmlXpath.clearParent",
    "onCommand:xmlXpath.setMode",
    "onCommand:xmlXpath.setPreferredAttributes",
    "onCommand:xmlXpath.setIgnoreIndexTags",
    "onCommand:xmlXpath.toggleDisableLeafIndex",
    "onCommand:xmlXpath.toggleSkipSingleIndex",
    "onCommand:xmlXpath.toggleUseXlinkLabelIndex",
    "onCommand:xmlXpath.toggleParentScopedIndexing",
    "onCommand:xmlXpath.toggleIgnoreParentSegment",
    "onCommand:xmlXpath.setXlinkLabelPattern",
    "onCommand:xmlXpath.setTemplate",
    "onCommand:xmlXpath.searchWithXPath",
    "onCommand:xmlXpath.toggleUseRelativePath",
    "onCommand:xmlXpath.toggleIncludeNamespaces",
    "onCommand:xmlXpath.toggleIncludeDefaultNamespaces",
    "onCommand:xmlXpath.addAlwaysIncludeTagFromCursor",
    "onCommand:xmlXpath.clearAlwaysIncludeTags",
    "onCommand:xmlXpath.setDontIgnoreAfterFromCursor",
    "onCommand:xmlXpath.clearDontIgnoreAfter",
    "onCommand:xmlXpath.toggleUseSmartRelativePath",
    "onCommand:xmlXpath.toggleSmartRelativeLandmarkMode",
    "onCommand:xmlXpath.setSmartRelativeNamespacePrefix",
    "onCommand:xmlXpath.setSmartRelativeSignificantAttributes",
    "onCommand:xmlXpath.toggleSmartRelativeIgnoreLastElement",
    "onCommand:xmlXpath.toggleSmartRelativeSingleLine",
    "onCommand:xmlXpath.setSmartRelativeVirtualRoot",
    "onCommand:xmlXpath.toggleSmartRelativeVirtualRootMode",
    "onCommand:xmlXpath.clearSmartRelativeVirtualRoot",
    "onCommand:xmlXpath.setSmartRelativeSignificantAttributes",
    "onCommand:xmlXpath.setForceIndexOneFor",
    "onCommand:xmlXpath.setExceptionsToIndexOneForcing",
    "onCommand:xmlXpath.toggleAttributeBasedIndexing",
    "onCommand:xmlXpath.setAttributeBasedIndexingAttribute",
    "onCommand:xmlXpath.toggleUseRelativePath",
    "onCommand:xmlXpath.toggleIncludeNamespaces",
    "onCommand:xmlXpath.toggleIncludeDefaultNamespaces"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "xmlXpath.copyXPath",
        "title": "XML XPath: Copy XPath from Cursor",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.setParent",
        "title": "XML XPath: Set Parent Tag",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.clearParent",
        "title": "XML XPath: Clear Parent Tag",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.setMode",
        "title": "XML XPath: Set XPath Mode",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.setPreferredAttributes",
        "title": "XML XPath: Set Preferred Attributes",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.setIgnoreIndexTags",
        "title": "XML XPath: Set Ignore-Index Tags",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.setTemplate",
        "title": "XML XPath: Set Predicate Template",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.toggleDisableLeafIndex",
        "title": "XML XPath: Toggle Disable Leaf Index",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.toggleSkipSingleIndex",
        "title": "XML XPath: Toggle Skip Single Index",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.toggleUseXlinkLabelIndex",
        "title": "XML XPath: Toggle Use XLink Label Index",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.toggleParentScopedIndexing",
        "title": "XML XPath: Toggle Parent-Scoped Indexing",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.toggleIgnoreParentSegment",
        "title": "XML XPath: Toggle Ignore Parent Segment",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.setXlinkLabelPattern",
        "title": "XML XPath: Set xlink:label Pattern",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.searchWithXPath",
        "title": "XML XPath: Search with XPath",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.setForceIndexOneFor",
        "title": "XML XPath: Set Force Index [1] Tags",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.setExceptionsToIndexOneForcing",
        "title": "XML XPath: Set Exceptions to Force Index [1]",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.toggleAttributeBasedIndexing",
        "title": "XML XPath: Toggle Attribute-Based Indexing",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.setAttributeBasedIndexingAttribute",
        "title": "XML XPath: Set Attribute for Attribute-Based Indexing",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.toggleUseRelativePath",
        "title": "XML XPath: Toggle Use Relative Path",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.toggleIncludeNamespaces",
        "title": "XML XPath: Toggle Include Namespaces",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.toggleIncludeDefaultNamespaces",
        "title": "XML XPath: Toggle Include Default Namespaces",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.toggleUseSmartRelativePath",
        "title": "XML XPath: Toggle Smart Relative Path",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.toggleSmartRelativeLandmarkMode",
        "title": "XML XPath: Toggle Smart Relative Landmark Mode",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.setSmartRelativeNamespacePrefix",
        "title": "XML XPath: Set Smart Relative Namespace Prefix",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.setSmartRelativeSignificantAttributes",
        "title": "XML XPath: Set Smart Relative Significant Attributes",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.toggleSmartRelativeIgnoreLastElement",
        "title": "XML XPath: Toggle Ignore Last Element in Smart Relative Path",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.toggleSmartRelativeSingleLine",
        "title": "XML XPath: Toggle Smart Relative Single Line",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.setSmartRelativeVirtualRoot",
        "title": "XML XPath: Set Smart Relative Virtual Root",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.toggleSmartRelativeVirtualRootMode",
        "title": "XML XPath: Toggle Virtual Root Mode (Include/Exclude)",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.clearSmartRelativeVirtualRoot",
        "title": "XML XPath: Clear Virtual Root",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.addAlwaysIncludeTagFromCursor",
        "title": "XML XPath: Add Always-Include Tag From Cursor",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.clearAlwaysIncludeTags",
        "title": "XML XPath: Clear Always-Include Tags",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.setDontIgnoreAfterFromCursor",
        "title": "XML XPath: Set 'Don't Ignore After' Anchor From Cursor",
        "category": "XML XPath"
      },
      {
        "command": "xmlXpath.clearDontIgnoreAfter",
        "title": "XML XPath: Clear 'Don't Ignore After' Anchor",
        "category": "XML XPath"
      }
    ],
    "keybindings": [
      {
        "key": "ctrl+shift+c",
        "command": "xmlXpath.copyXPath",
        "when": "editorTextFocus && editorLangId == xml"
      },
      {
        "key": "ctrl+shift+f",
        "command": "xmlXpath.searchWithXPath",
        "when": "editorTextFocus && editorLangId == xml"
      },
      {
        "key": "ctrl+shift+x",
        "command": "xmlXpath.toggleUseSmartRelativePath",
        "when": "editorLangId == xml"
      },
      {
        "key": "alt+shift+x",
        "command": "xmlXpath.searchWithXPath",
        "when": "editorLangId == xml"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "xmlXpath.copyXPath",
          "when": "editorLangId == xml",
          "group": "xmlXpath"
        },
        {
          "command": "xmlXpath.toggleDisableLeafIndex",
          "when": "editorTextFocus",
          "group": "xmlXpath"
        },
        {
          "command": "xmlXpath.toggleSkipSingleIndex",
          "when": "editorTextFocus",
          "group": "xmlXpath"
        },
        {
          "command": "xmlXpath.toggleUseXlinkLabelIndex",
          "when": "editorTextFocus",
          "group": "xmlXpath"
        },
        {
          "command": "xmlXpath.addAlwaysIncludeTagFromCursor",
          "when": "editorLangId == xml",
          "group": "xmlXpath"
        },
        {
          "command": "xmlXpath.setDontIgnoreAfterFromCursor",
          "when": "editorLangId == xml",
          "group": "xmlXpath"
        }
      ]
    },
    "configuration": {
      "title": "XML XPath Extension",
      "properties": {
        "xmlXpath.parentTag": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Parent tag from which to generate relative XPath."
        },
        "xmlXpath.mode": {
          "type": "object",
          "default": {
            "includeIndices": true,
            "includeAttributes": true
          },
          "description": "XPath generation mode options."
        },
        "xmlXpath.preferredAttributes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Preferred attributes for XPath predicates."
        },
        "xmlXpath.ignoreIndexTags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Tags for which index [1] should be omitted in XPath."
        },
        "xmlXpath.predicateTemplate": {
          "type": "string",
          "default": "[@{attr1}='{attr1V}']",
          "description": "Template for predicate rendering. Tokens: {tag}, {attr1}, {attr1V}, {xllv}, {xllvI}, {idx}."
        },
        "xmlXpath.disableLeafIndex": {
          "type": "boolean",
          "default": false,
          "description": "If true, omit the [n] index on the final (leaf) segment of the XPath."
        },
        "xmlXpath.skipSingleIndex": {
          "type": "boolean",
          "default": false,
          "description": "If true, omit all [1] indexes (i.e. when an element is the only child of its tag at that level)."
        },
        "xmlXpath.useXlinkLabelIndex": {
          "type": "boolean",
          "default": false,
          "description": "When true, use the numeric suffix parsed from xlink:label as the element index instead of the simple occurrence count."
        },
        "xmlXpath.useParentScopedIndices": {
          "type": "boolean",
          "default": false,
          "description": "If true, reset child-counters per parent; otherwise use global-depth counters."
        },
        "xmlXpath.ignoreParentSegment": {
          "type": "boolean",
          "default": false,
          "description": "When true, omit the parentTag itself from the generated XPath, showing only the descendant path."
        },
        "xmlXpath.maxParseSize": {
          "type": "number",
          "default": 1000000,
          "minimum": 10000,
          "description": "Maximum file size (in bytes) for full document parsing. Files larger than this will use partial parsing for performance. Default: 1MB."
        },
        "xmlXpath.xlinkLabelPattern": {
          "type": "object",
          "default": {
            "type": "any",
            "pattern": ""
          },
          "description": "Pattern for extracting numbers from xlink:label values"
        },
        "xmlXpath.forceIndexOneFor": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Tags that should always show index [1] (when skipSingleIndex is false). Empty array means no forcing."
        },
        "xmlXpath.exceptionsToIndexOneForcing": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Tags that are exceptions to forceIndexOneFor - these will never show [1]."
        },
        "xmlXpath.useAttributeBasedIndexing": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, elements are indexed based on their attribute values. Elements with same tag but different attributes get separate index sequences."
        },
        "xmlXpath.attributeBasedIndexingAttribute": {
          "type": "string",
          "default": "",
          "description": "The attribute to use for attribute-based indexing (e.g., 'ValuationType'). If empty, uses the first preferred attribute."
        },
        "xmlXpath.useRelativePath": {
          "type": "boolean",
          "default": false,
          "description": "Generate relative XPath (using //) instead of absolute path"
        },
        "xmlXpath.includeNamespaces": {
          "type": "boolean",
          "default": false,
          "description": "Include namespace prefixes in XPath"
        },
        "xmlXpath.includeDefaultNamespaces": {
          "type": "boolean",
          "default": false,
          "description": "Include default namespace handling in XPath"
        },
        "xmlXpath.useSmartRelativePath": {
          "type": "boolean",
          "default": false,
          "description": "Generate smart relative XPath starting from elements with significant attributes"
        },
        "xmlXpath.smartRelativeNamespacePrefix": {
          "type": "string",
          "default": "d",
          "description": "Namespace prefix to use in smart relative XPath (e.g., 'd' for 'd:ELEMENT')"
        },
        "xmlXpath.smartRelativeSignificantAttributes": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Attributes that make an element significant for smart relative XPath"
        },
        "xmlXpath.smartRelativeLandmarkMode": {
          "type": "boolean",
          "default": true,
          "description": "Use landmark mode (show only root + significant elements + target)"
        },
        "xmlXpath.smartRelativeIndentSize": {
          "type": "number",
          "default": 4,
          "description": "Number of spaces for indentation in smart relative XPath"
        },
        "xmlXpath.smartRelativeIdentifyingChildren": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Child elements that can identify their parent"
        },
        "xmlXpath.smartRelativeIgnoreLastElement": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, excludes the target element from smart relative XPath, showing only the path to its container"
        },
        "xmlXpath.smartRelativeSingleLine": {
          "type": "boolean",
          "default": false,
          "description": "Generate smart relative XPath as single line instead of multi-line format"
        },
        "xmlXpath.smartRelativeVirtualRoot": {
          "type": "string",
          "default": "",
          "description": "Virtual root element to start smart relative XPath from (e.g., 'PROPERTY', 'VALUATION'). Empty means use actual document root."
        },
        "xmlXpath.smartRelativeVirtualRootMode": {
          "type": "string",
          "enum": [
            "include",
            "exclude"
          ],
          "default": "include",
          "enumDescriptions": [
            "Include the virtual root element in the XPath",
            "Exclude the virtual root element, start from its children"
          ],
          "description": "Whether to include or exclude the virtual root element in the generated XPath"
        },
        "xmlXpath.smartRelativeAlwaysIncludeTags": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Tags that should always be treated as landmarks in Smart Relative mode. These can be added quickly with the command 'Add Always-Include Tag From Cursor'."
        },
        "xmlXpath.smartRelativeDontIgnoreAfter": {
          "type": "string",
          "default": "",
          "description": "Anchor element tag name: when set, Smart Relative mode will NOT ignore any elements that appear after this anchor element in the ancestor chain."
        }
      }
    }
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.3"
  },
  "devDependencies": {
    "vscode": "^1.1.37",
    "vscode-test": "^1.4.0"
  }
}
